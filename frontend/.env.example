# Frontend — SOS Sang 229 (Vite)
# Copy to `frontend/.env` (never commit `.env`).
# Vite inlines this at `npm run build` — set it on Vercel before building.
#
# Local:
#   VITE_API_BASE_URL=http://127.0.0.1:8000
# Vercel (Production / Preview):
#   VITE_API_BASE_URL=https://your-api.up.railway.app
#
# CORS: API always allows local Vite. Add the Vercel origin on Railway as
# FRONTEND_ORIGIN=https://your-app.vercel.app (comma-separated list OK).

VITE_API_BASE_URL=http://127.0.0.1:8000
