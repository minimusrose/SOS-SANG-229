# SOS Sang 229 — environment template
# Copy to `.env` (never commit `.env`).
# Names and comments only. Leave secrets empty or use clearly fake local placeholders.

# --- App ---
# Local: development. Railway API: production
APP_ENV=development

# Browser origin(s) allowed by API CORS.
# Local Vite is always allowed (http://localhost:5173 and http://127.0.0.1:5173).
# Production: set the Vercel URL (no trailing slash). Comma-separated list is OK
# if you also have a preview deployment.
# Railway example: FRONTEND_ORIGIN=https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Vite (copy into frontend/.env — Vite does not read this root file).
# Local:
#   VITE_API_BASE_URL=http://127.0.0.1:8000
# Vercel (Project Settings → Environment Variables, baked at `npm run build`):
#   VITE_API_BASE_URL=https://your-api.up.railway.app
# VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Database (PostgreSQL + PostGIS) — used by Alembic / SQLAlchemy ---
# Local example shape only:
#   postgresql://sos_sang:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/sos_sang_229
# Railway: reference the PostGIS service variable (do not paste a real URL here):
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   or DATABASE_URL=${{PostGIS.DATABASE_URL}}
# postgres:// (Railway) is accepted and normalized to postgresql://.
# Plain Postgres WITHOUT PostGIS will fail on CREATE EXTENSION / ST_DWithin.
# Leave empty until you run migrations. Never commit a real password.
DATABASE_URL=

# Matching radius in meters when hospital + donor both have GPS (default 15 km).
# City fallback is used when GPS is missing. Not a secret.
MATCH_RADIUS_METERS=15000

# --- Auth (JWT) ---
# Phone + password accounts, JWT bearer. JWT_SECRET is REQUIRED in production
# (APP_ENV=production). Locally, an empty value falls back to a dev-only key.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- SMS ---
# Demo / Railway: keep simulate (no Twilio network). Live stays off unless
# SMS_MODE=live AND all TWILIO_* credentials are set (still a stub, no HTTP).
SMS_MODE=simulate
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional later: TWILIO_MESSAGING_SERVICE_SID=

# --- Local Docker Postgres stub (docker-compose.yml) ---
POSTGRES_USER=sos_sang
POSTGRES_PASSWORD=
POSTGRES_DB=sos_sang_229
POSTGRES_PORT=5432
