# SOS Sang 229 — local environment template
# Copy to `.env` (never commit `.env`).
# Names and comments only. Leave values empty or use clearly fake local placeholders.

# --- App ---
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Database (PostgreSQL + PostGIS) — not wired yet ---
# Example shape only: postgresql://USER:PASSWORD@localhost:5432/sos_sang_229
DATABASE_URL=

# --- Auth (JWT) — not implemented yet ---
# Generate a long random string locally. Never reuse a real production secret.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Twilio SMS — not integrated yet ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional later: TWILIO_MESSAGING_SERVICE_SID=

# --- Local Docker Postgres stub (docker-compose.yml) ---
POSTGRES_USER=sos_sang
POSTGRES_PASSWORD=
POSTGRES_DB=sos_sang_229
POSTGRES_PORT=5432
